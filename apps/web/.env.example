# Copy to .env.local. Names only; never commit real values.

# The ChuckSales API (no trailing slash). Defaults to staging.
# NEXT_PUBLIC_API_URL=https://chucksale-backend.onrender.com/api/v1

# Data source: live (default) or "mock" (in-browser demo backend, packages/mock-api, with the Demo panel).
# NEXT_PUBLIC_API_SOURCE=mock

# WalletConnect (Reown) project id for phone wallets (LOBSTR, Varial app). Public; protected by its domain allowlist.
# Defaults to Chucksales' own Reown project (in features/wallet/kit.ts); set this only to use a different one.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
