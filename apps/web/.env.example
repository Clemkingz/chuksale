# Copy to .env.local. Names only; never commit real values (PRD §18 rule 13).

# Data source: "mock" (default: in-browser demo backend, packages/mock-api) or "live" (real API, later).
# NEXT_PUBLIC_API_SOURCE=mock

# Stellar (Testnet only until the mainnet release gate).
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# A funded Testnet account that seeded demo projects use as their destination, so real Testnet contributions
# succeed in mock mode (create one with Friendbot: https://laboratory.stellar.org). Public key only.
# NEXT_PUBLIC_DEMO_DESTINATION=G...

# WalletConnect (Reown) project id for phone wallets (LOBSTR, Varial app). Public; protected by its domain allowlist.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Real API (live mode only).
# API_PROXY_TARGET=http://localhost:8080/api/v1

# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
